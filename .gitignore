# Public source allowlist. Everything else in this working game installation is private/local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/docs/
!/tools/
!/outputs/
/outputs/*
!/outputs/TechnicalPolish/
!/outputs/RoRCraft-SkyCraft/
/outputs/RoRCraft-SkyCraft/*
!/outputs/RoRCraft-SkyCraft/src/
!/outputs/RoRCraft-SkyCraft/THIRD-PARTY-LICENSE.txt
/outputs/TechnicalPolish/*
!/outputs/TechnicalPolish/src/
!/outputs/TechnicalPolish/fabric/
!/outputs/TechnicalPolish/ShaderProject/
!/outputs/TechnicalPolish/Build-BlockShader.ps1
!/outputs/TechnicalPolish/Build-UnifiedVisuals.ps1
!/outputs/TechnicalPolish/Build-MovementPolish.ps1
!/outputs/TechnicalPolish/Build-BackgroundProbe.ps1
!/outputs/TechnicalPolish/*Checks.cs
!/outputs/TechnicalPolish/extract_menu_assets.py
!/outputs/TechnicalPolish/prepare_dance_textures.py
!/outputs/TechnicalPolish/prepare_dance_wave.py
!/outputs/TechnicalPolish/prepare_menu_wave.py

**/.gradle/
**/build/
**/logs/
**/run/
**/bin/
**/__pycache__/
**/Library/
**/Temp/
**/obj/
**/Logs/
**/UserSettings/
**/accounts.json
**/instance.cfg
**/*.log
**/*.dll
**/*.exe
**/*.jar
**/*.png
**/*.jpg
**/*.gif
**/*.ogg
**/*.wav
**/*.mp4
**/*.zip
**/*.keystore
**/*.pfx
**/.env*
**/MinecraftGlyphs.cs
